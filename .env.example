# Supabase Public Client Configuration (Vercel -> Project Settings -> Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-Only Secrets (NEVER prefix with NEXT_PUBLIC_ and NEVER commit .env.local!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
ADMIN_PASSWORD=set-your-strong-admin-password-in-vercel
ADMIN_SESSION_SECRET=set-a-long-random-32-char-secret-in-vercel
